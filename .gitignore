# Node
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/
out/

# Builds
dist/
build/
coverage/

# Variables de entorno / secretos
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
**/.venv/
**/venv/

# Python / ML caches
.pytest_cache/
.mypy_cache/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/

# Postman local
.postman/

# Archivos temporales
*.tmp
